# Copy to .env.local and fill in. Never commit real values.

# Production URL, e.g. https://retrovision.studio — enables canonical, absolute OG URLs and sitemap.
NEXT_PUBLIC_SITE_URL=

# Project inquiry form (Resend). Without these the form tells visitors it isn't connected.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=shahriarfardows@gmail.com
# Must be a sender on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
INQUIRY_FROM_EMAIL="Retro Vision <onboarding@resend.dev>"
